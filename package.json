{
  "name": "forma-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "skills/forma"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/validate.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "install:skill": "node tools/install.mjs",
    "format:check": "prettier --check 'tools/*.mjs' 'tests/*.mjs' 'packages/**/*.{mjs,js,jsx,json}' 'skills/forma/scripts/*.mjs' 'catalog/**/*.json' package.json skills/forma/package.json skills/forma/project-types.json",
    "catalog:site": "node tools/catalog-site.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "dependencies": {
    "pptxgenjs": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "kiwi-schema": "0.5.0",
    "leaflet": "1.9.4",
    "marked": "18.0.14",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "smol-toml": "1.9.0",
    "three": "0.184.0",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "world-atlas": "2.0.2"
  }
}
