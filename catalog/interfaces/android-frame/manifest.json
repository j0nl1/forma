{
  "schemaVersion": 1,
  "id": "android-frame",
  "kind": "primitive",
  "description": "An editable android frame interface frame.",
  "targets": ["interfaces"],
  "tags": ["interfaces", "primitive"],
  "entry": "android-frame.jsx",
  "requirements": ["react", "node-bundle"],
  "license": "MIT",
  "export": "AndroidDevice",
  "parameters": {
    "type": "object",
    "properties": {
      "width": {
        "type": "number",
        "default": 412,
        "description": "Frame width in pixels."
      },
      "height": {
        "type": "number",
        "default": 892,
        "description": "Frame height in pixels."
      },
      "dark": {
        "type": "boolean",
        "default": false,
        "description": "Use the dark frame variant."
      }
    },
    "additionalProperties": false
  },
  "dependencies": ["platform-materials"],
