{
  "schemaVersion": 1,
  "id": "audio-tutorial",
  "kind": "preset",
  "description": "An actionable walkthrough with ordered steps.",
  "targets": ["audio"],
  "tags": ["audio", "tutorial"],
  "guide": "generations/audio/tutorial.md",
  "files": [
    {
      "source": "LICENSE",
      "target": "LICENSE"
    },
    {
      "source": "catalog/audio/tutorial/README.md",
      "target": "README.md"
    },
    {
      "source": "catalog/audio/tutorial/manifest.json",
      "target": "manifest.json"
    },
    {
      "source": "catalog/audio/tutorial/preview.html",
      "target": "preview.html"
    },
    {
      "source": "catalog/audio/tutorial/template.json",
      "target": "template.json"
    }
  ],
  "requirements": ["speech-or-supplied-recording"],
  "license": "MIT",
  "entry": "template.json",
  "parameters": {
    "type": "object",
    "properties": {
      "language": {
        "type": ["string", "null"],
        "default": null,
        "description": "Choose a language with the user."
      },
      "targetSeconds": {
        "type": ["number", "null"],
        "default": null,
        "description": "Requested duration; null means estimate from the source."
      }
    },
    "additionalProperties": false
  },
  "dependencies": [],
  "preview": "preview.html"
}
